{
  "name": "dsh-mosaic",
  "version": "0.2.1",
  "type": "module",
  "description": "Lightweight visual answers for DeepSeek Harness: one compact visual style, an editable model prompt, dsh-view components, Mermaid diagrams, a sandboxed HTML/JS escape hatch, local-first interactions, and link-only media cards.",
  "author": "imwhatiam",
  "homepage": "https://github.com/imwhatiam/dsh-mosaic#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/imwhatiam/dsh-mosaic.git"
  },
  "bugs": {
    "url": "https://github.com/imwhatiam/dsh-mosaic/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "visualization",
    "mermaid",
    "diagram"
  ],
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./skill": "./SKILL.md",
    "./package.json": "./package.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "locale",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "screenshots.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
